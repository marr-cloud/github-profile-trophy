{
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build:cf": "cross-env NITRO_PRESET=cloudflare_module NITRO_STORAGE_TROPHY_DRIVER=cloudflare-kv-binding NITRO_STORAGE_TROPHY_BINDING=TROPHY_KV vite build",
    "deploy:cf": "pnpm build:cf && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "msw": "^2.15.0",
    "nitro": "latest",
    "typescript": "latest",
    "unstorage": "^1.17.5",
    "vite": "latest",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ofetch": "^1.5.1"
  }
}
