{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-profile-trophy",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "TROPHY_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
